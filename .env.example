# =========================================================
# profileRAG — .env.example
# Copy to .env and fill in what you have (all optional).
# The app works with ZERO keys using extractive mode.
# =========================================================

# --- LLM FALLBACK ORDER ---
# Comma-separated list. Providers without a key are auto-skipped.
# "extractive" is always the final fallback (no key needed).
LLM_FALLBACK_ORDER=groq,gemini,openrouter,cerebras,extractive

# --- GROQ ---
# Free tier: https://console.groq.com/
# Check current free model list at: https://console.groq.com/docs/models
# (Rosters change often — do NOT hard-code a model name here)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- GOOGLE GEMINI ---
# Free tier: https://aistudio.google.com/app/apikey
# Check current free model list at: https://ai.google.dev/gemini-api/docs/models/gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- OPENROUTER (free models only) ---
# Free account: https://openrouter.ai/
# Filter by ":free" suffix at: https://openrouter.ai/models?q=:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- CEREBRAS ---
# Free tier: https://cloud.cerebras.ai/
# Check current free model list at: https://inference-docs.cerebras.ai/introduction
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# --- SERVER ---
PORT=3001
